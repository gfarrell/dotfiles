# Include shared communication capabilities
include ~/.config/firejail/shared-communication.inc

# Whitelist aerc HTML emails aerc
whitelist /tmp/aerc*/*.htm

# Whitelist public folder
whitelist ${HOME}/public

# Prevent crashes due to https://github.com/netblue30/firejail/issues/6906
whitelist /usr/share/glycin-loaders
noblacklist /usr/bin/bwrap
noblacklist /proc/sys/kernel/overflowuid
noblacklist /proc/sys/kernel/overflowgid
private-bin bwrap
ignore seccomp !chroot
seccomp !chroot,!mount,!pivot_root,!umount2

# Allow firefox to inhibit screensavers
dbus-user.talk org.freedesktop.ScreenSaver

# Give firefox access to common programmes/addons/plugins
include firefox-common-addons.profile
